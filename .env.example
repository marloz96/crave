# Optional overrides. The app already points at the CRAVE Supabase project (src/config.ts).
# Set EXPO_PUBLIC_DEMO=1 to use built-in sample data instead of the real database.
EXPO_PUBLIC_DEMO=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat public SDK keys (RevenueCat dashboard > Project > API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
